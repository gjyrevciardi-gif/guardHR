# Copy to .env. Everything below has a development default; production values are enforced
# when APP_ENV=production (see docs/deployment.md).
APP_ENV=development

POSTGRES_DB=interviewguard
POSTGRES_USER=interviewguard
POSTGRES_PASSWORD=interviewguard_dev
POSTGRES_PORT=55432
BACKEND_PORT=8100
FRONTEND_PORT=3100
DATABASE_URL=postgresql+psycopg://interviewguard:interviewguard_dev@db:5432/interviewguard

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:8100/api
PUBLIC_APP_URL=http://localhost:3100

INITIAL_ADMIN_EMAIL=hr@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!
# Blank = open registration in development, closed in production. Admins can always create users via POST /api/auth/users.
REGISTRATION_ENABLED=

# Only true behind a proxy that overwrites X-Forwarded-For (the bundled nginx does).
TRUST_PROXY_HEADERS=false
RATE_LIMIT_ENABLED=true
# Hours between automatic retention purges; 0 disables the in-process schedule.
RETENTION_PURGE_INTERVAL_HOURS=24
# A call still in progress this many hours after it started is closed as abandoned (tab closed, no finish signal).
ABANDONED_SESSION_HOURS=12

# WebRTC STUN/TURN as JSON; blank = Google STUN. Add a TURN relay for candidates behind strict NATs, e.g.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
ICE_SERVERS=

# true = YOLO/OpenCV in the backend image (phone / extra-person detection); false = smaller API-only image.
INSTALL_CV=true
YOLO_MODEL_PATH=yolo11n.pt

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=NemoGuardHR <no-reply@nemoguard.test>
SMTP_USE_TLS=false
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
